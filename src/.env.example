# WATSONX_API_KEY — Your IBM watsonx.ai API key
# Get it from: cloud.ibm.com → watsonx.ai → Manage → API Keys
WATSONX_API_KEY=your_ibm_watsonx_api_key_here

# WATSONX_PROJECT_ID — Your watsonx.ai project ID
# Get it from: cloud.ibm.com → watsonx.ai → Projects → [Your Project] → Manage
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM_BOB_MCP_ENDPOINT — Your IBM Bob MCP server endpoint (for live data integration)
# See: bob.ibm.com/docs/ide/mcp
IBM_BOB_MCP_ENDPOINT=https://your-bob-mcp-server.ibm.com/api

# CHARUSAT_FMIS_API_KEY — CHARUSAT's FMIS attendance system API key
# Contact CHARUSAT IT department for access
CHARUSAT_FMIS_API_KEY=your_fmis_api_key_here

# CHARUSAT_EXAM_PORTAL_KEY — CHARUSAT exam results portal API key
CHARUSAT_EXAM_PORTAL_KEY=your_exam_portal_key_here
